<odoo>
  <record id="server_action_1054_create_bom_general_cost" model="ir.actions.server">
    <field name="name">Create BOM General Cost</field>
    <field name="model_id" search="[('model', '=', 'mrp.routing.workcenter')]"/>
    <field name="state">code</field>
    <field name="usage">base_automation</field>
    <field name="code"><![CDATA[new_record = env["x_mrp_bom_general_cost"].create({"x_studio_bom_general_cost_ids": record.bom_id.id, "x_studio_operation_id": record.id, "x_studio_planned_qty": record.time_cycle/60.00})

]]></field>
  </record>
