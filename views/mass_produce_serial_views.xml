<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ported_view_2600_mass_produce_serial_form" model="ir.ui.view">
        <field name="name">Mass Produce Serial Nos</field>
        <field name="model">mass_produce_serial</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form string="Mass Produce Serial Nos">
              <separator string="Serial Numbers to Produce:"/>
                <newline/>
                <group>
                  <field name="production_id" options="{'no_open': true}" readonly="True"/>
                  <field name="product_id" options="{'no_open': true}" readonly="True"/>
                  <field name="product_qty" options="{'no_open': true}" readonly="True"/>
                  <field name="serial_no_prefix" style="text-transform: uppercase;" readonly="generated == True" required="True"/>
                  <field name="prefix_status" force_save="1" readonly="True"/>
                  <field name="sequence_size" force_save="1" readonly="True" required="True"/>
                  <field name="starting_serial_no" force_save="1" readonly="True" required="True"/>
                  <field name="last_serial_no_id" options="{'no_open': true}" force_save="1" readonly="True"/>
                  <field name="generated" options="{'no_open': true}" invisible="1"/>
                </group>
                <newline/>
                <button name="%(BugFix-MRP.server_action_1149_mass_produce_serial_numbers_generate)d" string="Generate" type="action" class="oe_highlight" invisible="generated == True"/>
                <button name="%(BugFix-MRP.server_action_1150_mass_produce_serial_numbers_clear)d" string="Clear" type="action" class="oe_highlight" invisible="generated == False"/>
                <group>
                  <field name="mass_produce_serial_ids" nolabel="1" colspan="2">
                    <tree string="Details" create="false" editable="bottom" delete="false">
                      <field name="lotserial_number" options="{'no_open': true}" readonly="True"/>
                      <field name="product_uom_id" options="{'no_open': true}" readonly="True"/>
                      <field name="product_qty" options="{'no_open': true}" readonly="True"/>
                    </tree>
                  </field>
                </group>
                <newline/>
                <footer>
                  <button name="%(BugFix-MRP.server_action_1151_mass_produce_serial_numbers_create_original)d" string="OK" type="action" class="oe_highlight"/>
                  <button special="cancel" string="Cancel" class="oe_link"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="ported_view_5898_mass_produce_serial_form_studio" model="ir.ui.view">
        <field name="name">Odoo Studio: Mass Produce Serial Nos customization</field>
        <field name="model">mass_produce_serial</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="BugFix-MRP.ported_view_2600_mass_produce_serial_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='last_serial_no_id']" position="after">
                    <field name="accounting_company_id" string="Company" invisible="1"/>
                </xpath>
            </data>
        </field>
    </record>
  <record id="act_window_1146_mass_produce_serial" model="ir.actions.act_window">
    <field name="name">Mass Produce Serial</field>
    <field name="res_model">mass_produce_serial</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{}</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                    This is your new action.
                </p>
                <p>By default, it contains a list and a form view and possibly
                    other view types depending on the options you chose for your model.
                </p>
                <p>
                    You can start customizing these screens by clicking on the Studio icon on the
                    top right corner (you can also customize this help message there).
                </p>
            </field>
  </record>
    <record id="view_2623_default_tree_view_for_ir_model_837_e" model="ir.ui.view">
      <field name="name">Default tree view for ir.model(837,)</field>
      <field name="model">mass_produce_serial</field>
      <field name="type">tree</field>
      <field name="active" eval="False"/>
      <field name="arch" type="xml">
        <tree string="Mass Produce Serial"><field name="name"/></tree>
      </field>
    </record>
</odoo>
