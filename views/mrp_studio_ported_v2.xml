<?xml version="1.0" encoding="utf-8"?>
<!--
    BugFix-MRP v0.0.20: 3 form-view Studio inherits with hardcoded action refs.

    Restored view (was yanked in v0.0.19):
      * 3953 mrp.workorder.view.form (tablet)   642b - domain refs
        stock.lot.x_studio_production_id which BugFix-Stock owns; now
        dep-guaranteed via new BugFix-Stock manifest dep.

    New views:
      * 3945 mrp.bom form                        223b - "Update Cost" button.
        Ref name="1057" -> %(BugFix-MRP.server_action_1057_update_costs_in_bom)d
      * 3946 mrp.production form                3553b - Mass Produce / Update /
        Cancel Serial buttons + 6 button-attribute overrides.
        Refs name="1147"/"2534"/"3202" -> corresponding server_action_*
        xmlids. 7 x_studio_ fields referenced in modifier expressions
        (finished_products_location_updated, source_validate, mass_produced,
        tracked_item, serial_cancelled, temp_location, quantity_validation);
        all 7 are declared on models/mrp_production.py, so we inject
        invisible-sentinel <field/> elements to satisfy Odoo 17 strict
        modifier validation. Sentinels grouped inside a single
        <xpath expr="//sheet[1]" position="inside"> block.
-->
<odoo>

    <record id="ported_view_3945_mrp_bom_form_button" model="ir.ui.view">
        <field name="name">Odoo Studio: mrp.bom.form customization-button</field>
        <field name="model">mrp.bom</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//form[1]/sheet[1]" position="before">
                    <header>
                      <button type="action" name="%(BugFix-MRP.server_action_1057_update_costs_in_bom)d" string="Update Cost" class="btn-primary"/>
                  </header>
                  <header/>
                </xpath>
            </data>
        </field>
    </record>

    <record id="ported_view_3946_mrp_production_form_button" model="ir.ui.view">
        <field name="name">Odoo Studio: mrp.production.form-button</field>
        <field name="model">mrp.production</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//sheet[1]" position="inside">
                    <field name="x_studio_finished_products_location_updated" invisible="1"/>
                    <field name="x_studio_source_validate" invisible="1"/>
                    <field name="x_studio_mass_produced" invisible="1"/>
                    <field name="x_studio_tracked_item" invisible="1"/>
                    <field name="x_studio_serial_cancelled" invisible="1"/>
                    <field name="x_studio_temp_location" invisible="1"/>
                    <field name="x_studio_quantity_validation" invisible="1"/>
                </xpath>

                <xpath expr="//header/field[@name='show_lock']" position="after">
                  <button type="action" name="%(BugFix-MRP.server_action_1147_mass_produce_serial_numbers)d" string="Mass Produce Serial Nos" class="btn-primary" invisible="((x_studio_finished_products_location_updated == False) and (x_studio_source_validate == True)) or ((x_studio_mass_produced == True) or (x_studio_tracked_item == False))"/>
                </xpath>

                <xpath expr="//header/button[@name='button_mark_done'][3]" position="before">
                  <button type="action" name="%(BugFix-MRP.server_action_2534_finished_products_location_updated)d" string="Update Finished Product Location" class="btn-primary" invisible="((x_studio_finished_products_location_updated == True) and (x_studio_source_validate == True)) or (x_studio_source_validate == False)"/>
                </xpath>

                <xpath expr="//header/button[@name='action_cancel']" position="before">
                  <button type="action" name="%(BugFix-MRP.server_action_3202_mass_produce_serial_numbers_cancel_serial_no)d" string="Cancel Serial Nos" class="btn-primary" invisible="((x_studio_mass_produced == True) and (x_studio_serial_cancelled == True) and (state != 'draft')) or (x_studio_mass_produced == False)"/>
                </xpath>

                <xpath expr="//header/button[@name='action_confirm']" position="attributes">
                  <attribute name="invisible">(state != 'draft') or (((x_studio_mass_produced == False) and (x_studio_tracked_item == True)) or ((state != 'draft') or (x_studio_temp_location == True)))</attribute></xpath>

                <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                  <attribute name="invisible">((id == False) or (state in ('done', 'cancel')) or ((x_studio_serial_cancelled == False) and (x_studio_mass_produced == True)))</attribute></xpath>

                <xpath expr="//header/button[@name='button_mark_done'][3]" position="attributes">
                  <attribute name="invisible">(move_raw_ids or not show_produce) or (((state != 'to_close') and ((qty_producing != 0) or (state not in ('confirmed', 'progress')))) or (((x_studio_mass_produced == False) and (x_studio_tracked_item == True)) or (((x_studio_finished_products_location_updated == False) and (x_studio_source_validate == True)) or ((set(move_raw_ids).intersection([])) or (x_studio_quantity_validation == True)))))</attribute></xpath>

                <xpath expr="//header/button[@name='button_plan']" position="attributes">
                  <attribute name="invisible">(state not in ('confirmed', 'progress', 'to_close') or not workorder_ids or is_planned) or (((x_studio_mass_produced == False) and (x_studio_tracked_item == True)) or ((is_planned == True) or ((set(workorder_ids).intersection([])) or (state not in ('confirmed', 'progress', 'to_close')))))</attribute></xpath>

                <xpath expr="//header/button[@name='do_unreserve']" position="attributes">
                  <attribute name="invisible">(not unreserve_visible) or (((x_studio_mass_produced == False) and (x_studio_tracked_item == True)) or (unreserve_visible == False))</attribute></xpath>

                <xpath expr="//header/button[@name='button_scrap']" position="attributes">
                  <attribute name="invisible">(state in ('cancel', 'draft')) or (((x_studio_mass_produced == False) and (x_studio_tracked_item == True)) or (state in ('cancel', 'draft')))</attribute></xpath>

                <xpath expr="//header/button[@name='action_serial_mass_produce_wizard']" position="replace"/>
            </data>
        </field>
    </record>

    <record id="ported_view_3953_mrp_workorder_form_tablet" model="ir.ui.view">
        <field name="name">mrp.workorder.view.form.inherit.quality.tablet.new-button</field>
        <field name="model">mrp.workorder</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="mrp_workorder.mrp_workorder_view_form_tablet"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='finished_lot_id']" position="attributes">
                    <attribute name="domain">[('product_id', '=', product_id),('x_studio_production_id', '=', production_id)]</attribute>
                </xpath>
            </data>
        </field>
    </record>

</odoo>
