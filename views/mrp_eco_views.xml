<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ported_view_5062_mrp_eco_tree" model="ir.ui.view">
        <field name="name">Odoo Studio: mrp.eco.view.tree customization</field>
        <field name="model">mrp.eco</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="mrp_plm.mrp_eco_view_tree"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="x_studio_item_approved" optional="hide"/>
              </xpath>
              <xpath expr="//field[@name='stage_id']" position="after">
                <field name="active" optional="show" column_invisible="1"/>
              </xpath>
            </data>
        </field>
    </record>
    <record id="ported_view_4830_mrp_eco_form" model="ir.ui.view">
        <field name="name">Odoo Studio: mrp.eco.view.form customization</field>
        <field name="model">mrp.eco</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="mrp_plm.mrp_eco_view_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//sheet[1]" position="inside">
                    <field name="state" invisible="1"/>
                    <field name="type" invisible="1"/>
                </xpath>

                <xpath expr="//button[@name='approve']" position="attributes">
                    <attribute name="studio_approval">True</attribute>
                </xpath>
                <xpath expr="//button[@name='action_apply']" position="attributes">
                    <attribute name="studio_approval">True</attribute>
                </xpath>
                <xpath expr="//field[@name='product_tmpl_id']" position="after">
                    <field name="x_studio_tag_description" string="Tag Description" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='bom_id']" position="attributes">
                    <attribute name="invisible">(type in ('routing', 'product')) or (type in ['routing', 'product'])</attribute>
                    <attribute name="readonly">(state != 'confirmed') or (((x_studio_item_approved != True) and (type == 'bom')) or (state != 'confirmed'))</attribute>
                    <attribute name="required">(type in ('bom', 'both')) or (type in ['bom', 'both'])</attribute>
                </xpath>
                <xpath expr="//field[@name='bom_id']" position="after">
                    <field name="x_studio_error" string="Error" force_save="True" readonly="1" invisible="((x_studio_item_approved == True) and (type == 'bom')) or ((product_tmpl_id == False) or (type == 'product'))"/>
                </xpath>
                <xpath expr="//field[@name='effectivity']" position="attributes">
                    <attribute name="invisible">id == 0</attribute>
                    <attribute name="readonly">(state == 'done') or (state == 'done')</attribute>
                </xpath>
                <xpath expr="//field[@name='tag_ids']" position="attributes">
                    <attribute name="readonly">(state == 'done') or (state == 'done')</attribute>
                </xpath>
                <xpath expr="//field[@name='tag_ids']" position="after">
                    <field name="x_studio_item_approved" string="Approved Item"/>
                </xpath>
            </data>
        </field>
    </record>
    <record id="view_5063_mrp_eco_view_form_button_e" model="ir.ui.view">
      <field name="name">mrp.eco.view.form_button</field>
      <field name="model">mrp.eco</field>
      <field name="type">form</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="mrp_plm.mrp_eco_view_form"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
    <xpath expr="//header/button[@name='action_new_revision']" position="after">
      <!-- STRIPPED action button aid=2307 unresolvable -->
    </xpath>
  </data>
      </field>
    </record>
</odoo>
