<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_mrp_bom_general_cost" model="ir.actions.act_window">
    <field name="name">mrp.bom.general.cost</field>
    <field name="res_model">mrp_bom_general_cost</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{}</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                    This is your new action.
                </p>
                <p>By default, it contains a list and a form view and possibly
                    other view types depending on the options you chose for your model.
                </p>
                <p>
                    You can start customizing these screens by clicking on the Studio icon on the
                    top right corner (you can also customize this help message there).
                </p>
            </field>
  </record>
    <record id="view_mrp_bom_general_cost_form" model="ir.ui.view">
      <field name="name">Default form view for mrp_bom_general_cost</field>
      <field name="model">mrp_bom_general_cost</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="mrp.bom.general.cost">
    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
    <field name="active" invisible="1"/>
    <div class="oe_title">
                <h1>
                    <field name="name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_a334bf">
      <group name="studio_group_a334bf_left"/>
      <group name="studio_group_a334bf_right"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <!-- STRIPPED field message_follower_ids not on mrp_bom_general_cost -->
    <!-- STRIPPED field message_ids not on mrp_bom_general_cost -->
    <!-- STRIPPED field activity_ids not on mrp_bom_general_cost -->
  </div>
</form>
      </field>
    </record>
    <record id="view_mrp_bom_general_cost_list" model="ir.ui.view">
      <field name="name">Default list view for mrp_bom_general_cost</field>
      <field name="model">mrp_bom_general_cost</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree>
  <field name="sequence" widget="handle"/>
  <field name="name"/>
</tree>
      </field>
    </record>
    <record id="view_mrp_bom_general_cost_search" model="ir.ui.view">
      <field name="name">Default search view for mrp_bom_general_cost</field>
      <field name="model">mrp_bom_general_cost</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="name"/>
  <separator/>
  <filter string="Archived" name="archived_mrp_bom_general_cost" domain="[['active', '=', False]]"/>
  <separator/>
</search>
      </field>
    </record>
    <record id="view_default_list_view_for_mrp_bom_general_cost_inherit" model="ir.ui.view">
      <field name="name">Odoo Studio: Default list view for mrp_bom_general_cost customization</field>
      <field name="model">mrp_bom_general_cost</field>
      <field name="type">tree</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="BugFix-MRP.view_mrp_bom_general_cost_list"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//field[@name='sequence']" position="before">
    <field name="bom_general_cost_ids" string="BOM General Cost"/>
    <field name="prod_bom_general_cost_ids" string="Prod. BOM General Cost"/>
    <field name="prod_bom_line_id" string="Prod. BOM Line ID" column_invisible="1"/>
    <field name="operation_id" string="Operation"/>
    <field name="planned_qty" string="Planned Hour"/>
    <field name="actual_qty" string="Actual Hour"/>
    <field name="cost" string="Cost/Hour"/>
    <field name="total_cost" string="Total Cost"/>
    <field name="total_actual_cost" string="Total Actual Cost"/>
    <field name="accounting_currency_id" column_invisible="1"/>
  </xpath>
  <xpath expr="//field[@name='name']" position="attributes">
    <attribute name="column_invisible">1</attribute></xpath>
</data>
      </field>
    </record>
</odoo>
